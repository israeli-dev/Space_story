{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abandoned-but-not-forgotten/space-story/site.schema.json",
  "title": "Exploration site record",
  "description": "One documented location in the Abandoned but Not Forgotten archive. Every field is either sourced or explicitly marked as unknown — the build script refuses records that fabricate coordinates.",
  "type": "object",
  "required": [
    "id",
    "body",
    "name",
    "mission",
    "agency",
    "category",
    "date",
    "status",
    "summary",
    "narrative",
    "lat",
    "lon",
    "coordSystem",
    "coordAccuracy",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable, unique, kebab-case identifier."
    },
    "body": { "enum": ["earth", "moon", "mars", "venus"] },
    "name": { "type": "string", "minLength": 3 },
    "siteName": { "type": "string", "description": "Named region, e.g. Mare Tranquillitatis." },
    "mission": { "type": "string" },
    "program": { "type": "string" },
    "agency": { "type": "string" },
    "country": { "type": "string" },
    "category": {
      "enum": ["launch", "facility", "crewed-landing", "robotic-landing", "rover", "impact", "artifact"]
    },
    "categoryDetail": { "type": "string", "description": "e.g. S-IVB impact, sample-return lander, Mercury pad." },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2})?(-[0-9]{2})?$",
      "description": "ISO date of the event at this location."
    },
    "dateNote": { "type": "string" },
    "status": { "type": "string" },
    "statusKind": { "enum": ["success", "partial", "failure", "ongoing", "unknown"] },
    "summary": { "type": "string", "maxLength": 320 },
    "narrative": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 30 }
    },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Degrees east, -180..180. Western longitudes are negative."
    },
    "coordSystem": { "type": "string" },
    "coordAccuracy": { "enum": ["surveyed", "mapped", "approximate", "uncertain"] },
    "coordNote": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "additionalProperties": false,
        "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "title", "credit"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string" },
          "credit": { "type": "string" },
          "caption": { "type": "string" },
          "sourceUrl": { "type": "string" }
        }
      }
    },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": "string" },
          "accessed": { "type": "string" }
        }
      }
    },
    "related": { "type": "array", "items": { "type": "string" } },
    "narrationAudio": { "type": "string" },
    "featured": { "type": "boolean" }
  }
}
